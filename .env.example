# SkillLoop AI - Environment Configuration
# Copy this file to .env and provide your credentials.
# The app includes a Graceful Fallback Matrix so it runs even if external APIs are not yet configured.

# -----------------------------------------------------------------------------
# Supabase Configuration (Backend & Database)
# -----------------------------------------------------------------------------
# Obtain from: https://supabase.com/dashboard/project/_/settings/api
# VITE_SUPABASE_URL is client-safe
VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY is client-safe (protected by Row Level Security)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_SERVICE_ROLE_KEY is server-only (NEVER expose to frontend bundle)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# -----------------------------------------------------------------------------
# OpenAI API (AI Mentoring, Skill Discovery, Content Moderation)
# -----------------------------------------------------------------------------
# Obtain from: https://platform.openai.com/api-keys
# Server-only. If omitted, SkillLoop AI provides intelligent domain-tailored guidance fallback.
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# YouTube Data API v3 (Resource Discovery)
# -----------------------------------------------------------------------------
# Obtain from: https://console.cloud.google.com/apis/credentials
# Client or server accessible. If omitted or quota exhausted (100 units/day),
# SkillLoop AI automatically serves its pre-cached 30+ skill catalogue.
VITE_YOUTUBE_API_KEY=AIzaSyYourYouTubeApiKeyHere

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
VITE_APP_URL=http://localhost:5173
VITE_APP_NAME="SkillLoop AI"
VITE_APP_TAGLINE="Learn one skill. Teach another. Grow together."
